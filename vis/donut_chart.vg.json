{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart showing Australian household pet ownership penetration.",
  "title": {
    "text": "Australian Pet Ownership Share",
    "subtitle": "Nearly 73% of households own at least one pet (Animal Medicines Australia)",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "data": {
    "values": [
      {"category": "Pet Owning Households", "value": 73, "percentage": "73%"},
      {"category": "Non-Pet Owning Households", "value": 27, "percentage": "27%"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 70, "outerRadius": 110, "stroke": "#ffffff", "strokeWidth": 2},
      "encoding": {
        "theta": {"field": "value", "type": "quantitative"},
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": ["Pet Owning Households", "Non-Pet Owning Households"],
            "range": ["#3182ce", "#e2e8f0"]
          },
          "legend": {
            "title": "Household Status",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {"field": "category", "type": "nominal", "title": "Group"},
          {"field": "percentage", "type": "nominal", "title": "Share"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 24,
        "fontWeight": "bold",
        "fill": "#1a365d"
      },
      "encoding": {
        "text": {"value": "73%"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}