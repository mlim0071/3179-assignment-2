{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Sorted vertical bar chart comparing total pet populations across species.",
  "data": {"url": "data/species_preferences.csv"},
  "width": 860,
  "height": 320,
  "transform": [{"calculate": "datum.total_population_thousands / 1000", "as": "population_millions"}],
  "encoding": {
    "x": {
      "field": "species",
      "type": "nominal",
      "sort": {"field": "population_millions", "op": "max", "order": "ascending"},
      "title": "Pet Type",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "population_millions",
      "type": "quantitative",
      "title": "Total Population (Millions)",
      "scale": {"domain": [0, 14]},
      "axis": {"format": ".1f", "labelExpr": "datum.value + 'M'"}
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Animal Class",
      "scale": {"domain": ["Mammals", "Aquatic", "Avian", "Reptiles"], "range": ["#cc79a7", "#56b4e9", "#e69f00", "#882255"]},
      "legend": {"orient": "bottom", "direction": "horizontal"}
    },
    "tooltip": [
      {"field": "species", "type": "nominal", "title": "Species"},
      {"field": "group", "type": "nominal", "title": "Animal Class"},
      {"field": "population_millions", "type": "quantitative", "title": "Total Population (M)", "format": ".2f"},
      {"field": "penetration_rate", "type": "quantitative", "title": "Household Penetration (%)"}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusTop": 4},
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "padding": {"top": 10, "bottom": 10, "left": 10, "right": 10}
}