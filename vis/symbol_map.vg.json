{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: dogs and cats received by RSPCA shelters per state, 2024-25, shown as triangles sized by number of animals. Source: RSPCA Australia, National Statistics 2024-25.",
  "width": 440,
  "height": 340,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "description": "Grey state outlines",
      "data": {"url": "data/australia_states.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#e2e8f0", "stroke": "#ffffff", "strokeWidth": 0.8}
    },
    {
      "description": "Triangles sized by animals received",
      "data": {
        "url": "data/animals_received.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_received": "number",
            "dogs_received": "number",
            "cats_received": "number",
            "symbol_lon": "number",
            "symbol_lat": "number"
          }
        }
      },
      "mark": {"type": "point", "shape": "triangle-up", "filled": true, "color": "#b5338a", "opacity": 0.92, "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "symbol_lon", "type": "quantitative"},
        "latitude": {"field": "symbol_lat", "type": "quantitative"},
        "size": {
          "field": "total_received",
          "type": "quantitative",
          "scale": {"domain": [0, 15000], "range": [0, 9000], "type": "sqrt", "zero": true},
          "legend": {
            "title": "Animals received",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [1000, 5000, 10000, 15000],
            "format": ",.0f",
            "symbolFillColor": "#b5338a",
            "symbolType": "triangle-up",
            "labelFontSize": 13,
            "titleFontSize": 13
          }
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "dogs_received", "format": ",", "title": "Dogs"},
          {"field": "cats_received", "format": ",", "title": "Cats"},
          {"field": "total_received", "format": ",", "title": "Total"}
        ]
      }
    },
    {
      "description": "State code inside each triangle",
      "data": {"url": "data/animals_received.csv", "format": {"type": "csv", "parse": {"symbol_lon": "number", "symbol_lat": "number"}}},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "#ffffff", "dy": 7},
      "encoding": {
        "longitude": {"field": "symbol_lon", "type": "quantitative"},
        "latitude": {"field": "symbol_lat", "type": "quantitative"},
        "text": {"field": "state_code"}
      }
    }
  ],
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "padding": {"top": 10, "bottom": 10, "left": 10, "right": 10}
}