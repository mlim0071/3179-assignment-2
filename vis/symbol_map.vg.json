{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australian Pet Population & Density by State",
  "width": 500,
  "height": 350,
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 600
  },
  "data": {
    "url": "../data/aus_states_pets.csv"
  },
  "mark": {
    "type": "circle",
    "opacity": 0.8,
    "stroke": "#222",
    "strokeWidth": 0.5
  },
  "encoding": {
    "longitude": {
      "field": "longitude",
      "type": "quantitative"
    },
    "latitude": {
      "field": "latitude",
      "type": "quantitative"
    },
    "size": {
      "field": "total_pets_mil",
      "type": "quantitative",
      "title": "Total Pets (Millions)",
      "scale": {"range": [100, 1000]}
    },
    "color": {
      "field": "pet_density_pct",
      "type": "quantitative",
      "title": "Density (%)",
      "scale": {"scheme": "blues"}
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State/Territory"},
      {"field": "pet_density_pct", "type": "quantitative", "title": "Pet Density (%)"},
      {"field": "total_pets_mil", "type": "quantitative", "title": "Total Pets (M)"}
    ]
  }
}