{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal Lollipop Chart sorted by descending household penetration.",
  "data": {"url": "data/species_preferences.csv"},
  "width": 360,
  "height": 280,
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": ["Dogs", "Cats", "Fish", "Birds", "Small mammals", "Reptiles"],
      "title": "Pet Type"
    },
    "x": {
      "field": "penetration_rate",
      "type": "quantitative",
      "title": "Household Penetration (%)",
      "scale": {"domain": [0, 60]}
    }
  },
  "layer": [
    {"mark": {"type": "rule", "color": "#cbd5e1", "strokeWidth": 2}, "encoding": {"x2": {"value": 0}}},
    {
      "mark": {"type": "point", "size": 140, "filled": true},
      "encoding": {
        "tooltip": [
          {"field": "species", "type": "nominal", "title": "Species"},
          {"field": "penetration_rate", "type": "quantitative", "title": "Penetration Rate (%)"}
        ],
        "color": {
          "field": "species",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Dogs", "Cats", "Fish", "Birds", "Small mammals", "Reptiles"],
            "range": ["#0072b2", "#d55e00", "#94a3b8", "#94a3b8", "#94a3b8", "#94a3b8"]
          }
        }
      }
    }
  ],
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "padding": {"top": 10, "bottom": 10, "left": 10, "right": 10}
}