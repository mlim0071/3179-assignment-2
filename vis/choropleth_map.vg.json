{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State-Level Pet Ownership Density (%)",
    "subtitle": "Percentage of households owning pets by State/Territory"
  },
  "width": 500,
  "height": 320,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_1_states_provinces.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_1_states_provinces"
    }
  },
  "transform": [
    {
      "filter": "datum.properties.admin == 'Australia'"
    },
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "../data/aus_states_pets.csv"
        },
        "key": "state",
        "fields": ["pet_density_pct", "total_pets_mil", "avg_vet_cost_index"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "pet_density_pct",
      "type": "quantitative",
      "title": "Density (%)",
      "scale": {
        "scheme": "blues"
      }
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "State/Territory"},
      {"field": "pet_density_pct", "type": "quantitative", "title": "Pet Density (%)"},
      {"field": "total_pets_mil", "type": "quantitative", "title": "Total Pets (Millions)"}
    ]
  }
}