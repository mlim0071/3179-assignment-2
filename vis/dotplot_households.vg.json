{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cleveland dot plot showing absolute owning households across species.",
  "title": {
    "text": "Australian Households Owning Pets",
    "subtitle": "Ranked by total owning households (millions)"
  },
  "data": {"url": "data/species_preferences.csv"},
  "width": 600,
  "height": 300,
  "transform": [
    {"calculate": "datum.owning_households_thousands / 1000", "as": "households_millions"},
    {
      "calculate": "format(datum.households_millions, '.2f') + 'M (' + datum.penetration_rate + '%)'",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": {"field": "households_millions", "op": "max", "order": "descending"},
      "title": "Pet Type",
      "axis": {"grid": true}
    },
    "x": {
      "field": "households_millions",
      "type": "quantitative",
      "title": "Owning Households (Millions)",
      "scale": {"domain": [0, 7]},
      "axis": {"format": ".1f", "labelExpr": "datum.value + 'M'"}
    }
  },
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 140, "opacity": 0.95},
      "encoding": {
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "Animal Class",
          "scale": {
            "domain": ["Mammals", "Aquatic", "Avian", "Reptiles"],
            "range": ["#cc79a7", "#56b4e9", "#e69f00", "#882255"]
          }
        },
        "tooltip": [
          {"field": "species", "type": "nominal", "title": "Species"},
          {"field": "group", "type": "nominal", "title": "Animal Class"},
          {"field": "households_millions", "type": "quantitative", "title": "Owning Households (M)", "format": ".2f"},
          {"field": "penetration_rate", "type": "quantitative", "title": "Household Penetration (%)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.species == 'Dogs' || datum.species == 'Cats'"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "fontSize": 13, "fontWeight": "bold"},
      "encoding": {"text": {"field": "label", "type": "nominal"}, "color": {"value": "#334155"}}
    }
  ],
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "title": {
      "font": "Playfair Display", "fontSize": 20, "fontWeight": 700, "anchor": "middle",
      "subtitleFont": "Space Grotesk", "subtitleFontSize": 13, "subtitleColor": "#334155",
      "subtitleLineHeight": 17, "subtitlePadding": 8
    },
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "padding": {"top": 20, "bottom": 40, "left": 10, "right": 10}
}