{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of pet populations in Australia, grouped by animal class and species.",
  "width": 520,
  "height": 340,
  "padding": 5,
  "autosize": "pad",
  "title": {
    "text": "How Many Pets of Each Kind? Australia's Pet Population",
    "subtitle": [
      "Rectangle size = total animals kept as pets (millions). Hover for household ownership."
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#475569",
    "offset": 10
  },
  "data": [
    {
      "name": "table",
      "url": "../data/species_preferences.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      }
    },
    {
      "name": "treeRoot",
      "values": [
        {
          "id": "All pets"
        }
      ]
    },
    {
      "name": "groups",
      "source": "table",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group"
          ]
        },
        {
          "type": "formula",
          "expr": "'group:' + datum.group",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "'All pets'",
          "as": "parent"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "table",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.species",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "'group:' + datum.group",
          "as": "parent"
        },
        {
          "type": "formula",
          "expr": "datum.total_population_thousands",
          "as": "size"
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "treeRoot",
        "groups",
        "leaves"
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "size",
          "method": "squarify",
          "paddingInner": 2,
          "round": true,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leafNodes",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        }
      ]
    },
    {
      "name": "groupNodes",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Mammals",
        "Aquatic",
        "Avian",
        "Reptiles"
      ],
      "range": [
        "#b45309",
        "#2563eb",
        "#7c3aed",
        "#059669"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Animal class",
      "orient": "right",
      "symbolType": "square",
      "symbolSize": 150,
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leafNodes"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "group"
          },
          "fillOpacity": {
            "value": 0.9
          },
          "tooltip": {
            "signal": "{'Pet': datum.species, 'Animal class': datum.group, 'Total animals': format(datum.total_population_thousands / 1000, '.1f') + ' million', 'Households owning': format(datum.penetration_rate, '.1f') + '%'}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "groupNodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#1e293b"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leafNodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 7"
          },
          "text": {
            "field": "species"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "Space Grotesk, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fillOpacity": [
            {
              "test": "datum.x1 - datum.x0 > 50 && datum.y1 - datum.y0 > 30",
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leafNodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 23"
          },
          "text": {
            "signal": "format(datum.total_population_thousands / 1000, '.1f') + 'M'"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "Space Grotesk, sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fillOpacity": [
            {
              "test": "datum.x1 - datum.x0 > 50 && datum.y1 - datum.y0 > 42",
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leafNodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "datum.y0 + 8"
          },
          "angle": {
            "value": 90
          },
          "text": {
            "signal": "datum.species + '  ' + format(datum.total_population_thousands / 1000, '.1f') + 'M'"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "Space Grotesk, sans-serif"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fillOpacity": [
            {
              "test": "datum.species === 'Small mammals'",
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      }
    }
  ]
}