{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart of household pet ownership 2016-2025. Source: AMA, Pets in Australia 2025.",
  "title": {
    "text": "Pet Ownership Surged During the Pandemic and Kept Rising",
    "subtitle": "Share of Australian households owning each kind of pet, by survey year"
  },
  "width": 720,
  "height": 400,
  "data": {"url": "data/pet_trends.csv"},
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Survey year",
      "scale": {"domain": [2015.5, 2027.6], "nice": false, "zero": false},
      "axis": {"values": [2016, 2019, 2022, 2025], "format": "d", "grid": false}
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "Households with this pet (%)",
      "scale": {"domain": [0, 85]},
      "axis": {"values": [0, 20, 40, 60, 80]}
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "legend": null,
      "scale": {"domain": ["Any pet", "Dogs", "Cats"], "range": ["#1f2937", "#0072b2", "#d55e00"]}
    }
  },
  "layer": [
    {
      "description": "Shaded band for the pandemic years (2019 to 2022)",
      "data": {"values": [{"year": 2019, "year2": 2022}]},
      "mark": {"type": "rect", "color": "#cbd5e1", "opacity": 0.35},
      "encoding": {"x2": {"field": "year2"}, "y": null, "color": null}
    },
    {
      "description": "Lines with points",
      "mark": {"type": "line", "strokeWidth": 3.5, "point": {"filled": true, "size": 90}},
      "encoding": {
        "tooltip": [
          {"field": "group", "title": "Pet"},
          {"field": "year", "type": "ordinal", "title": "Survey year"},
          {"field": "pct", "title": "Households (%)"}
        ]
      }
    },
    {
      "description": "Label at the end of each line",
      "transform": [
        {"filter": "datum.year == 2025"},
        {"calculate": "datum.group + '  ' + datum.pct + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 14, "fontWeight": "bold"},
      "encoding": {"text": {"field": "label"}}
    }
  ],
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "title": {
      "font": "Playfair Display", "fontSize": 20, "fontWeight": 700, "anchor": "middle",
      "subtitleFont": "Space Grotesk", "subtitleFontSize": 13, "subtitleColor": "#334155",
      "subtitleLineHeight": 17, "subtitlePadding": 8
    },
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "padding": {"top": 20, "bottom": 40, "left": 10, "right": 10}
}