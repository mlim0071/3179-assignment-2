{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Multi-line chart tracking household penetration trends across historical survey waves.",
  "title": {
    "text": "Household Pet Penetration Trends Over Time",
    "subtitle": "Comparing overall pet ownership alongside dog and cat penetration rates (%)",
    "anchor": "start",
    "offset": 15
  },
  "data": {
    "url": "data/pet_trends.csv"
  },
  "width": 450,
  "height": 280,
  "encoding": {
    "x": {
      "field": "year",
      "type": "nominal",
      "title": "Survey Year",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "Household Penetration (%)",
      "scale": {"domain": [0, 100]},
      "axis": {
        "format": "d",
        "labelExpr": "datum.value + '%'"
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Category",
      "scale": {
        "domain": ["Any pet", "Dogs", "Cats"],
        "range": ["#3182ce", "#1f4e78", "#d97706"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {"value": "#1e293b"},
        "tooltip": [
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "group", "type": "nominal", "title": "Category"},
          {"field": "pct", "type": "quantitative", "title": "Penetration Rate (%)"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}