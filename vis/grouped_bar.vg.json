{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped Bar Chart comparing animal population vs owner households.",
  "title": {
    "text": "Total Pet Population vs. Owning Households ('000s)",
    "subtitle": "Comparing absolute numbers across species"
  },
  "data": {
    "url": "../data/species_preferences.csv"
  },
  "transform": [
    {
      "fold": ["owning_households_thousands", "total_population_thousands"],
      "as": ["metric_type", "count_thousands"]
    },
    {
      "calculate": "datum.metric_type == 'owning_households_thousands' ? 'Owning Households' : 'Total Animals'",
      "as": "Metric"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {"field": "species", "type": "nominal", "title": "Pet Type"},
    "y": {"field": "count_thousands", "type": "quantitative", "title": "Count ('000s)"},
    "xOffset": {"field": "Metric"},
    "color": {
      "field": "Metric",
      "type": "nominal",
      "scale": {"range": ["#3182ce", "#319795"]}
    },
    "tooltip": [
      {"field": "species", "type": "nominal", "title": "Species"},
      {"field": "Metric", "type": "nominal", "title": "Type"},
      {"field": "count_thousands", "type": "quantitative", "title": "Count ('000s)"}
    ]
  },
  "width": 400,
  "height": 280
}