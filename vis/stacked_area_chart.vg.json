{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Normalized 100% stacked area chart tracking expenditure category shifts over time.",
  "title": {
    "text": "Shift in National Pet Expenditure Composition",
    "subtitle": "Proportional breakdown of spending categories across survey waves (%)"
  },
  "data": {
    "url": "data/pet_trends.csv"
  },
  "width": 450,
  "height": 280,
  "encoding": {
    "x": {
      "field": "year",
      "type": "nominal",
      "title": "Survey Year",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "spend_amount_billion",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Percentage Share (%)",
      "axis": {"format": "%"}
    },
    "color": {
      "field": "category_spending",
      "type": "nominal",
      "title": "Spending Category",
      "scale": {
        "domain": ["Pet food", "Veterinary services", "Pet services/grooming", "Products/accessories", "Pet insurance"],
        "range": ["#3182ce", "#1f4e78", "#d97706", "#8b5cf6", "#38a169"]
      }
    },
    "tooltip": [
      {"field": "year", "type": "nominal", "title": "Year"},
      {"field": "category_spending", "type": "nominal", "title": "Category"},
      {"field": "spend_amount_billion", "type": "quantitative", "title": "Amount ($B)", "format": "$.2f"}
    ]
  },
  "mark": {
    "type": "area",
    "opacity": 0.85
  },
  "config": {
    "view": {"stroke": null}
  }
}