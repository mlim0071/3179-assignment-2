{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling cartogram: each state is a circle sized by population (ABS, June 2025) and coloured by animals received by RSPCA per 100,000 residents (RSPCA National Statistics 2024-25). Circle positions are computed from state centre points with an overlap-removal step (columns x, y, radius in data/state_cartogram.csv).",
  "width": 480,
  "height": 470,
  "data": {
    "url": "data/state_cartogram.csv",
    "format": {
      "type": "csv",
      "parse": {
        "population_thousands": "number",
        "animals_received": "number",
        "animals_rehomed": "number",
        "pct_rehomed": "number",
        "x": "number",
        "y": "number",
        "radius": "number",
        "area": "number",
        "received_per_100k": "number"
      }
    }
  },
  "encoding": {
    "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 440], "nice": false, "zero": false}, "axis": null},
    "y": {"field": "y", "type": "quantitative", "scale": {"domain": [430, 0], "nice": false, "zero": false}, "axis": null}
  },
  "layer": [
    {
      "description": "Faint state outlines behind the circles",
      "data": {"url": "data/australia_states.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#f8fafc", "stroke": "#94a3b8", "strokeWidth": 1},
      "encoding": {"x": null, "y": null}
    },
    {
      "description": "Circles: area = population, colour = animals received per 100,000 people",
      "mark": {"type": "circle", "stroke": "#334155", "strokeWidth": 1, "opacity": 0.92},
      "encoding": {
        "size": {"field": "area_px", "type": "quantitative", "scale": null, "legend": null},
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": ["Animals received", "per 100,000 people"],
          "scale": {
            "domain": ["Under 100", "100 to 199", "200 to 299", "300 or more"],
            "range": ["#edf8e9", "#a1d99b", "#2e9e55", "#005a32"]
          },
          "legend": {"orient": "bottom", "direction": "horizontal", "labelFontSize": 13, "titleFontSize": 13, "symbolType": "circle", "symbolSize": 260}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "population_thousands", "format": ",", "title": "Population ('000)"},
          {"field": "animals_received", "format": ",", "title": "Animals received"},
          {"field": "animals_rehomed", "format": ",", "title": "Animals rehomed"},
          {"field": "pct_rehomed", "format": ".1f", "title": "Rehomed (%)"},
          {"field": "received_per_100k", "format": ",", "title": "Received per 100,000 people"}
        ]
      }
    },
    {
      "description": "State code inside big circles (white on dark, dark on light)",
      "transform": [{"filter": "datum.radius >= 20"}],
      "mark": {"type": "text", "fontSize": 14, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "state_code"},
        "color": {"condition": {"test": "datum.received_per_100k >= 200", "value": "#ffffff"}, "value": "#1f2937"}
      }
    },
    {
      "description": "State code beside small circles",
      "transform": [
        {"filter": "datum.radius < 20 && datum.state_code != 'NT'"},
        {"calculate": "datum.x + datum.radius + 5", "as": "x"}
      ],
      "mark": {"type": "text", "fontSize": 13, "fontWeight": "bold", "align": "left", "color": "#1f2937"},
      "encoding": {"text": {"field": "state_code"}}
    },
    {
      "description": "NT label on the left so it does not run into Queensland",
      "transform": [
        {"filter": "datum.state_code == 'NT'"},
        {"calculate": "datum.x - datum.radius - 5", "as": "x"}
      ],
      "mark": {"type": "text", "fontSize": 13, "fontWeight": "bold", "align": "right", "color": "#1f2937"},
      "encoding": {"text": {"field": "state_code"}}
    },
    {
      "description": "Short note: the one comparison that matters, plus the pound-animal footnote",
      "data": {"values": [{"x": 10, "y": 385}]},
      "transform": [
        {
          "calculate": "['ACT: 522 per 100,000, nearly double','the next highest (SA, 280)','(ACT, NT, TAS figures exclude pound animals)']",
          "as": "note"
        }
      ],
      "mark": {"type": "text", "align": "left", "fontSize": 13, "fontStyle": "italic", "color": "#475569", "lineBreak": "\n"},
      "encoding": {"text": {"field": "note"}}
    }
  ],
  "config": {
    "font": "Space Grotesk",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 14, "titlePadding": 10, "labelColor": "#1f2937", "titleFontWeight": 600},
    "legend": {"labelFontSize": 13, "titleFontSize": 13, "labelColor": "#1f2937", "titleFontWeight": 600}
  },
  "transform": [
    {
      "calculate": "datum.received_per_100k >= 300 ? '300 or more' : datum.received_per_100k >= 200 ? '200 to 299' : datum.received_per_100k >= 100 ? '100 to 199' : 'Under 100'",
      "as": "band"
    },
    {"calculate": "datum.area * 1.19", "as": "area_px"}
  ],
  "projection": {"type": "mercator", "scale": 506, "center": [135, -30], "translate": [218.2, 251.3]},
  "padding": {"top": 10, "bottom": 10, "left": 10, "right": 10}
}